# -----------------------------------------------------------------------------
# City Quest environment variables
# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables. NEVER commit real values.
# -----------------------------------------------------------------------------

# Supabase project URL (Supabase → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anon / publishable key (safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL of the deployed app, without a trailing slash.
# Used for NFC sticker URLs and email confirmation links.
# Production example: https://cityquest.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IANA time zone used to display check-in and redemption times.
APP_TIME_ZONE=UTC

# Not required: the app never uses the Supabase service-role key.
# Do not add SUPABASE_SERVICE_ROLE_KEY to Vercel.

# Privacy notice details shown at /privacy (fill these in before launch).
ORGANIZER_NAME=City Quest Organising Committee
PRIVACY_CONTACT_EMAIL=privacy@example.com
# Days after the event that participant data is kept before deletion.
DATA_RETENTION_DAYS=90
